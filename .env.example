# AdvSOC example environment configuration
# NEVER place real credentials in this file.

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Riyadh
TZ=Asia/Riyadh

# Optional custom n8n encryption key
N8N_ENCRYPTION_KEY=replace-with-secure-random-value

# External services
VIRUSTOTAL_API_KEY=replace-with-your-api-key
SLACK_TOKEN=replace-with-your-token

# LLM provider
LLM_API_KEY=replace-with-your-api-key